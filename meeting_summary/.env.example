# --- Speech-to-text providers (auto-fallback in this order) ---
# The tool tries each provider in turn and switches to the next when one's
# free quota is exhausted. A provider with no key is silently skipped.
STT_PROVIDER_ORDER=gladia,speechmatics,gemini
MEETING_LANGUAGE=ja

GLADIA_API_KEY=
SPEECHMATICS_API_KEY=

# Optional: override the known monthly free-tier minutes used for pre-skipping.
# GLADIA_FREE_MINUTES=600
# SPEECHMATICS_FREE_MINUTES=480

# --- Gemini (meeting summarizer + final STT fallback) ---
# A single GEMINI_API_KEY works, or use numbered keys to auto-fail over when one
# hits a rate/quota limit. Tried in order: GEMINI_API_KEY, then GEMINI_API_KEY1,
# GEMINI_API_KEY2, ...
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
