# Provide one or more Gemini API keys. A single GEMINI_API_KEY works, or use
# numbered keys to auto-fail over when one hits a rate/quota limit. They are
# tried in order: GEMINI_API_KEY first, then GEMINI_API_KEY1, GEMINI_API_KEY2, ...
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
